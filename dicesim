import random

while True:
    command = input("Roll? [y/n]: ").lower()

    if command == "n":
        break

    if command == "y":
        roll = random.randint(1, 6)

        dice = {
            1: "[     ]\n[  •  ]\n[     ]",
            2: "[•    ]\n[     ]\n[    •]",
            3: "[•    ]\n[  •  ]\n[    •]",
            4: "[•   •]\n[     ]\n[•   •]",
            5: "[•   •]\n[  •  ]\n[•   •]",
            6: "[•   •]\n[•   •]\n[•   •]"
        }

        print(dice[roll])
