def encrypt(text, shift):
    result = ""

    for char in text:
        if char.isalpha():
            base = ord("A") if char.isupper() else ord("a")
            result += chr((ord(char) - base + shift) % 26 + base)
        else:
            result += char

    return result


message = input("Message: ")
shift = int(input("Shift: "))

print("\nEncrypted:")
print(encrypt(message, shift))
